# === Gemini API ===
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=600
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=1
GEMINI_RETRY_DELAY_SECONDS=1

# === Database ===
DATABASE_URL=sqlite:///./industrial_maintenance.db

# === Chat ===
CHAT_CONTEXT_MAX_CHARS=12000
CHAT_MIN_RETRIEVAL_SCORE=0.45
CHAT_SENSOR_READING_LIMIT=5
CHAT_MAINTENANCE_RECORD_LIMIT=3

# === CORS ===
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000

# === Qdrant ===
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=industrial_maintenance

# === Application ===
APP_ENV=development
APP_NAME=industrial-maintenance-ai
LOG_LEVEL=INFO

# === Frontend ===
FRONTEND_API_BASE_URL=
